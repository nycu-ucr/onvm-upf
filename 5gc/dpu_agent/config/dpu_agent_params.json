  "dl-encap-entries": 1000000,
  // ARP handling: 0 = fall through to host kernel via catch-all
  //               1 = BF3 ARM answers ARP itself
  "enable-arp-responder": 1,
  // ── BDP buffer allocator (byte-budget + EWMA max-min) ──────────────
  // m-op-bytes: TOTAL DPU buffering byte budget (operator DDR). 67108864 =
  //   64 MiB = legacy cap (32768 * 2 KiB). "0xFFFFFFFFFFFFFFFF" = OFF (legacy
  //   packet caps = eval baseline). default-seed-rate-kbps: cold-start demand
  //   for a NO-GBR/MBR flow until its EWMA gets a sample. t-hold-ms: horizon
  //   (U_i = rate*T_hold). tick-ms: recompute interval. ewma-alpha: weight %.
  //   measure-demand: 1=EWMA (product), 0=static QoS-seed (v1 ablation).
  "m-op-bytes": "17179869184",
  "default-seed-rate-kbps": 10000,
  "t-hold-ms": 1000,
  "tick-ms": 100,
  "ewma-alpha": 30,
  "measure-demand": 1,
  // ── GBR YELLOW buffered shaper ─────────────────────────────────────
  // m-shape-bytes: global queued-byte budget for shaped GBR YELLOW (logically
  //   separate from m-op-bytes; both draw on the same physical mbuf pool).
  //   "0" = OFF → legacy token-bucket pass/drop policer. Default 1 GiB.
  // shape-max-delay-ms: per-flow delay target; q_max_bytes = EIR * delay/1000.
  "m-shape-bytes": "1073741824",
  "shape-max-delay-ms": 50
}